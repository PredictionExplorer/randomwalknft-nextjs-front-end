# The app refuses to start unless all four are set in the process environment (e.g. export in the
# shell before `pnpm dev`, or your host’s env settings). Values below are placeholders only.
#
# NEXT_PUBLIC_NETWORK — one of: local | sepolia | mainnet
NEXT_PUBLIC_NETWORK=
# NEXT_PUBLIC_API_BASE_URL — Go webserv origin, no trailing slash (RandomWalk API + images are derived)
NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_RPC_URL — JSON-RPC HTTP URL for viem/wagmi (your node)
NEXT_PUBLIC_RPC_URL=

# Optional — redundant servers (comma-separated). When set, these take precedence over the
# singular vars above: traffic rotates hourly between the servers (round robin) and fails over
# to the next one when the picked server is unreachable or answers 5xx.
# NEXT_PUBLIC_API_URLS=https://a1.randomwalknft.com,https://a2.randomwalknft.com
# NEXT_PUBLIC_RPC_URLS=https://rpc1.randomwalknft.com,https://rpc2.randomwalknft.com
# NEXT_PUBLIC_SITE_URL — canonical public site origin, no trailing slash
NEXT_PUBLIC_SITE_URL=https://randomwalknft.com

# Optional — block explorer base for links (defaults per network preset)
# NEXT_PUBLIC_BLOCK_EXPLORER_URL=

# Optional — branding (defaults in src/lib/config.ts)
# NEXT_PUBLIC_SITE_NAME=
# NEXT_PUBLIC_SITE_DESCRIPTION=
