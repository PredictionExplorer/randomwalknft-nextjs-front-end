{
  "name": "randomwalknft-nextjs-front-end",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "lint": "pnpm typegen && eslint . --max-warnings=0",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm knip",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:functional": "playwright test tests/e2e/public.spec.ts tests/e2e/flows.spec.ts tests/e2e/a11y.spec.ts tests/e2e/wallet.spec.ts tests/e2e/wallet-mobile.spec.ts --workers=4 && playwright test tests/e2e/hydration.spec.ts --project=chromium --workers=2",
    "test:e2e:visual": "playwright test tests/e2e/visual.spec.ts --project=chromium",
    "test:e2e:visual:update": "bash scripts/visual-baselines.sh",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:lighthouse": "lhci collect --config=./lighthouserc.json && lhci assert --config=./lighthouserc.json && lhci upload --config=./lighthouserc.json",
    "test:ci": "pnpm check && pnpm test:unit && pnpm test:e2e && pnpm test:lighthouse",
    "generate:contracts": "wagmi generate",
    "postinstall": "pnpm generate:contracts",
    "prepare": "husky",
    "test:e2e:live": "E2E_UPSTREAM=live playwright test tests/e2e/public.spec.ts tests/e2e/hydration.spec.ts --project=chromium --workers=4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{mjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@metamask/connect-evm": "^2.1.1",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.39.0",
    "motion": "^13.1.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "uqr": "^0.1.3",
    "viem": "^2.56.3",
    "wagmi": "^3.7.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.3.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@wagmi/cli": "^2.10.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
